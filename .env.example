# S3 settings fragment. Merge into the existing backend env file.
# Spring Boot does not automatically load .env; use Docker --env-file or IDE environment settings.
# Keep the existing database/JWT/Firebase settings when updating the production env.
VIDEO_S3_ENABLED=true
VIDEO_S3_BUCKET=your-private-video-bucket
VIDEO_S3_REGION=ap-northeast-2

# Optional values already defaulted by application.yml:
# VIDEO_S3_KEY_PREFIX=inning-records
# VIDEO_UPLOAD_URL_TTL=10m
# VIDEO_DOWNLOAD_URL_TTL=10m
# VIDEO_MAX_SIZE=500MB
# VIDEO_ALLOWED_CONTENT_TYPES=video/mp4,video/quicktime,video/webm

# Profile photos reuse this private bucket and EC2 role under profile-images/.
# PROFILE_IMAGE_MAX_SIZE=10MB
# PROFILE_IMAGE_UPLOAD_URL_TTL=5m
# PROFILE_IMAGE_DOWNLOAD_URL_TTL=5m

# EC2 uses its instance role. No static AWS access keys are required there.
# Local development can use an existing AWS profile:
# AWS_PROFILE=your-profile
