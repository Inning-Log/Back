{
  "CORSRules": [
    {
      "AllowedOrigins": [
        "https://inning-log.vercel.app",
        "http://localhost:5173"
      ],
      "AllowedMethods": ["PUT", "GET", "HEAD"],
      "AllowedHeaders": ["*"],
      "ExposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type",
        "Content-Range",
        "Accept-Ranges"
      ],
      "MaxAgeSeconds": 3000
    }
  ]
}
