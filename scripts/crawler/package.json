{
  "name": "inning-log-crawler",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "Policy-gated, low-impact baseball game data collector",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "crawl": "node src/crawler.js --once",
    "crawl:schedule": "node src/crawler.js --scheduled",
    "config:check": "node src/crawler.js --check-config",
    "config:print": "node src/crawler.js --print-config",
    "policy:check": "node src/crawler.js --check-policy",
    "test": "node --test"
  },
  "dependencies": {
    "axios": "^1.7.4",
    "cheerio": "^1.0.0",
    "node-cron": "^4.6.0",
    "robots-parser": "^3.0.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  }
}
