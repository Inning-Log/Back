# Optional loader inputs. Relative paths are resolved from scripts/crawler,
# independent of the shell's current working directory.
CRAWLER_CONFIG=config/crawler.yml
CRAWLER_PROFILE=fixture
# CRAWLER_ENV_FILE=.env

# Safe local defaults. External providers remain disabled and unverified.
CRAWLER_ENABLED=true
CRAWLER_SOURCE=fixture
CRAWLER_TIMEZONE=Asia/Seoul
CRAWLER_IDENTITY_CONTACT=mailto:inning-log-student-project@example.invalid
# CRAWLER_DATE=2026-08-25

# Limits and human-readable durations.
CRAWLER_MAX_GAMES=20
CRAWLER_MAX_DETAILS=4
CRAWLER_MAX_EVENTS=40
CRAWLER_INCLUDE_PLAY_DESCRIPTIONS=false
CRAWLER_RETRY_COUNT=2
CRAWLER_RETRY_BASE_DELAY=1s
CRAWLER_RETRY_MAX_DELAY=30s
CRAWLER_TIMEOUT=12s
CRAWLER_MIN_HOST_INTERVAL=2s
CRAWLER_MAX_REQUESTS_PER_RUN=12
CRAWLER_MAX_ATTEMPTS_PER_RUN=24
CRAWLER_MAX_RESPONSE_BYTES=2097152
CRAWLER_MEMORY_CACHE_TTL=1h
CRAWLER_JITTER_RATIO=0.15
CRAWLER_CIRCUIT_FAILURE_THRESHOLD=3
CRAWLER_CIRCUIT_COOLDOWN=6h

# Execution and output.
CRAWLER_MODE=once
CRAWLER_CRON="*/5 * * * *"
CRAWLER_OUTPUT_DIR=out
CRAWLER_OUTPUT_ENABLED=true
CRAWLER_FORCE_WRITE=false
CRAWLER_DRY_RUN=false

# Policy defaults fail closed. Do not enable external providers merely to make
# a check pass; record actual written evidence, scope, review and expiry first.
CRAWLER_KILL_SWITCH=false
CRAWLER_FAIL_CLOSED=true
CRAWLER_REQUIRE_HTTPS=true
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_ROBOTS_CACHE_TTL=24h
CRAWLER_AUTH_REVIEW_MAX_AGE=7d
CRAWLER_ALLOW_UNDOCUMENTED_API=false

CRAWLER_FIXTURE_ENABLED=true
CRAWLER_FIXTURE_FILE=fixtures/games.sample.json
CRAWLER_KBO_ENABLED=false
CRAWLER_KBO_AUTHORIZATION_STATUS=unverified
# CRAWLER_KBO_AUTHORIZATION_EVIDENCE=permission-document-id
# CRAWLER_KBO_AUTHORIZATION_REVIEWED_AT=2026-08-26T09:00:00+09:00
# CRAWLER_KBO_AUTHORIZATION_EXPIRES_AT=2026-09-26T09:00:00+09:00
# CRAWLER_KBO_AUTHORIZATION_SCOPES=schedule,robots-disallow-override
CRAWLER_KBO_ROBOTS_EXCEPTION=false
CRAWLER_KBO_UNDOCUMENTED_API_APPROVED=false
CRAWLER_NAVER_ENABLED=false
CRAWLER_NAVER_AUTHORIZATION_STATUS=unverified
# CRAWLER_NAVER_AUTHORIZATION_EVIDENCE=permission-document-id
# CRAWLER_NAVER_AUTHORIZATION_REVIEWED_AT=2026-08-26T09:00:00+09:00
# CRAWLER_NAVER_AUTHORIZATION_EXPIRES_AT=2026-09-26T09:00:00+09:00
# CRAWLER_NAVER_AUTHORIZATION_SCOPES=schedule,relay,record,robots-disallow-override
# 설명 원문까지 서면 허가된 경우에만 위 목록에 relay-text를 추가합니다.
CRAWLER_NAVER_ROBOTS_EXCEPTION=false
CRAWLER_NAVER_UNDOCUMENTED_API_APPROVED=false

# Deprecated SCRAPER_* variables are read for compatibility but emit warnings.
# Prefer the CRAWLER_* names above.
